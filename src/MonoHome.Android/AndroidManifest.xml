<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Backup stays off: the GitHub PAT ciphertext is useless without the device-bound
       Keystore key, and the plaintext save registry would otherwise leave the device. -->
  <application android:allowBackup="false" android:icon="@mipmap/appicon" android:label="@string/app_name" android:roundIcon="@mipmap/appicon" android:supportsRtl="true">
  </application>
</manifest>
