<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:id="@+id/main_scroll" xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0B1414" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="20dp" android:paddingRight="20dp" android:paddingTop="22dp" android:paddingBottom="30dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="MONO / HOME" android:textColor="#E9F4EF" android:textSize="15sp" android:textStyle="bold" android:letterSpacing="0.12" />
      <Button android:id="@+id/settings_button" android:layout_width="wrap_content" android:layout_height="34dp" android:paddingLeft="10dp" android:paddingRight="10dp" android:backgroundTint="#162623" android:text="设置" android:textColor="#91AAA1" android:textSize="10sp" />
      <Button android:id="@+id/top_import_button" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginLeft="6dp" android:paddingLeft="10dp" android:paddingRight="10dp" android:backgroundTint="#D6FF63" android:text="＋ 导入存档" android:textColor="#142019" android:textSize="10sp" />
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:scrollbars="none">
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/nav_home" android:layout_width="wrap_content" android:layout_height="34dp" android:backgroundTint="#1B312D" android:text="⌂  我的仓库" android:textColor="#D6FF63" android:textSize="10sp" />
        <Button android:id="@+id/nav_saves" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginLeft="5dp" android:backgroundTint="#162623" android:text="▣  我的存档" android:textColor="#91AAA1" android:textSize="10sp" />
        <Button android:id="@+id/nav_history" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginLeft="5dp" android:backgroundTint="#162623" android:text="↺  传送记录" android:textColor="#91AAA1" android:textSize="10sp" android:visibility="gone" />
      </LinearLayout>
    </HorizontalScrollView>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="30dp" android:text="LOCAL TRANSFER CENTER / 01" android:textColor="#D6FF63" android:textSize="10sp" android:fontFamily="monospace" android:letterSpacing="0.14" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="你的宝可梦，&#10;随时在手。" android:textColor="#E9F4EF" android:textSize="36sp" android:textStyle="bold" android:lineSpacingMultiplier="0.9" />
    <TextView android:id="@+id/status_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:background="@drawable/card" android:padding="14dp" android:text="本地处理 · 不上传任何存档。" android:textColor="#91AAA1" android:textSize="12sp" />
    <ProgressBar android:id="@+id/transfer_progress" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="10dp" android:indeterminate="true" android:visibility="gone" android:indeterminateTint="#D6FF63" />
    <LinearLayout android:id="@+id/transfer_visual" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="#0D1917" android:padding="12dp" android:gravity="center_vertical" android:visibility="gone">
      <TextView android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:text="▣" android:textColor="#8DE4D1" android:textSize="18sp" />
      <FrameLayout android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:layout_marginLeft="8dp" android:layout_marginRight="8dp" android:background="#315249">
        <View android:id="@+id/transfer_packet" android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="center_vertical|left" android:background="@drawable/transfer_packet" />
      </FrameLayout>
      <TextView android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:text="◇" android:textColor="#D6FF63" android:textSize="18sp" />
    </LinearLayout>
    <TextView android:id="@+id/transfer_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="4dp" android:text="本地处理 · 不上传到网络" android:textColor="#91AAA1" android:textSize="10sp" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:orientation="horizontal">
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginRight="5dp" android:background="@drawable/card" android:orientation="vertical" android:padding="12dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="仓库" android:textColor="#91AAA1" android:textSize="10sp" /><TextView android:id="@+id/warehouse_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00" android:textColor="#E9F4EF" android:textSize="24sp" android:textStyle="bold" /></LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="3dp" android:layout_marginRight="3dp" android:background="@drawable/card" android:orientation="vertical" android:padding="12dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="已识别存档" android:textColor="#91AAA1" android:textSize="10sp" /><TextView android:id="@+id/save_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00" android:textColor="#E9F4EF" android:textSize="24sp" android:textStyle="bold" /></LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="5dp" android:background="@drawable/card" android:orientation="vertical" android:padding="12dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="数据位置" android:textColor="#91AAA1" android:textSize="10sp" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="本地" android:textColor="#D6FF63" android:textSize="24sp" android:textStyle="bold" /></LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/connected_saves_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="已连接存档" android:textColor="#E9F4EF" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="导入一次，之后持续识别与同步" android:textColor="#91AAA1" android:textSize="11sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
      <LinearLayout android:id="@+id/emerald_source_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginRight="5dp" android:background="@drawable/card" android:clickable="true" android:focusable="true" android:orientation="vertical" android:padding="13dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="◇  绿宝石 · SAV" android:textColor="#E9F4EF" android:textStyle="bold" android:textSize="13sp" /><TextView android:id="@+id/emerald_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="尚未导入" android:textColor="#91AAA1" android:textSize="10sp" /><Button android:id="@+id/import_emerald" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="9dp" android:text="导入 / 更新" android:textColor="#D6FF63" android:textSize="11sp" android:backgroundTint="#1B312D" /></LinearLayout>
      <LinearLayout android:id="@+id/heartgold_source_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="5dp" android:background="@drawable/card" android:clickable="true" android:focusable="true" android:orientation="vertical" android:padding="13dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✦  心金 / 魂银 · SAV" android:textColor="#E9F4EF" android:textStyle="bold" android:textSize="13sp" /><TextView android:id="@+id/heartgold_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="尚未导入" android:textColor="#91AAA1" android:textSize="10sp" /><Button android:id="@+id/import_heartgold" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="9dp" android:text="导入 / 更新" android:textColor="#D6FF63" android:textSize="11sp" android:backgroundTint="#1B312D" /></LinearLayout>
    </LinearLayout>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="已发布路线：Emerald → HeartGold / SoulSilver · 合法转换" android:textColor="#D6FF63" android:textSize="10sp" android:fontFamily="monospace" />
    <LinearLayout android:id="@+id/warehouse_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:gravity="center_vertical"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="仓库" android:textColor="#E9F4EF" android:textSize="18sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="选择宝可梦，编辑后下载到任意已识别存档" android:textColor="#91AAA1" android:textSize="11sp" /></LinearLayout><Button android:layout_width="wrap_content" android:layout_height="36dp" android:backgroundTint="#162623" android:text="全部 ⌄" android:textColor="#91AAA1" android:textSize="10sp" /></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/card" android:orientation="vertical" android:padding="13dp">
      <TextView android:id="@+id/warehouse_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="本地仓库为空" android:textColor="#91AAA1" android:textSize="11sp" />
      <LinearLayout android:id="@+id/warehouse_grid" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
      <Spinner android:id="@+id/warehouse_picker" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/warehouse_actionbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:background="#162623" android:padding="10dp" android:gravity="center_vertical" android:visibility="gone"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/warehouse_selected_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="已选择 0 只" android:textColor="#E9F4EF" android:textSize="12sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="选择目标后自动进行合法适配" android:textColor="#91AAA1" android:textSize="10sp" /></LinearLayout><Button android:id="@+id/warehouse_batch_download" android:layout_width="wrap_content" android:layout_height="42dp" android:backgroundTint="#D6FF63" android:text="下载至目标存档" android:textColor="#142019" android:textSize="10sp" /></LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="上传仓库" android:textColor="#E9F4EF" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="按游戏盒子查看来源宝可梦，点击图标查看详情并加入上传" android:textColor="#91AAA1" android:textSize="11sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:background="@drawable/card" android:orientation="vertical" android:padding="10dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical">
        <Button android:id="@+id/source_previous_box" android:layout_width="42dp" android:layout_height="match_parent" android:backgroundTint="#102820" android:contentDescription="上一个盒子" android:text="‹" android:textColor="#8DE4D1" android:textSize="22sp" />
        <TextView android:id="@+id/source_box_title" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#0B1915" android:gravity="center" android:text="仓库 1\n0 / 30 槽位" android:textColor="#E9F4EF" android:textSize="11sp" />
        <Button android:id="@+id/source_next_box" android:layout_width="42dp" android:layout_height="match_parent" android:backgroundTint="#102820" android:contentDescription="下一个盒子" android:text="›" android:textColor="#8DE4D1" android:textSize="22sp" />
      </LinearLayout>
      <GridLayout android:id="@+id/source_box_grid" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:alignmentMode="alignMargins" android:columnCount="5" android:useDefaultMargins="true" />
    </LinearLayout>
    <Button android:id="@+id/upload_button" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="9dp" android:backgroundTint="#D6FF63" android:text="上传 0 只至中央仓库" android:textColor="#142019" android:visibility="gone" />
    <Spinner android:id="@+id/source_picker" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <ImageView android:id="@+id/pokemon_icon" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/selected_pokemon" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="编辑工作副本" android:textColor="#E9F4EF" android:textSize="18sp" android:textStyle="bold" android:visibility="gone" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="原存档不会被修改；导出时再次检查合法性" android:textColor="#91AAA1" android:textSize="11sp" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/card" android:orientation="vertical" android:padding="13dp" android:visibility="gone">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="目标存档 / 转换方式" android:textColor="#91AAA1" android:textSize="10sp" />
      <Spinner android:id="@+id/target_picker" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="3dp" />
      <EditText android:id="@+id/species_input" style="@style/DarkField" android:hint="种类编号 1–1025（留空不修改）" android:inputType="number" /><EditText android:id="@+id/nickname_input" style="@style/DarkField" android:hint="昵称（留空不修改）" /><EditText android:id="@+id/level_input" style="@style/DarkField" android:hint="等级 1–100" android:inputType="number" /><EditText android:id="@+id/nature_input" style="@style/DarkField" android:hint="性格编号 0–24（留空不修改）" android:inputType="number" /><EditText android:id="@+id/ability_input" style="@style/DarkField" android:hint="特性序号 0–2（留空不修改）" android:inputType="number" /><EditText android:id="@+id/gender_input" style="@style/DarkField" android:hint="性别 0=男 / 1=女 / 2=无性别" android:inputType="number" /><EditText android:id="@+id/form_input" style="@style/DarkField" android:hint="形态编号 0–255（留空不修改）" android:inputType="number" /><EditText android:id="@+id/shiny_input" style="@style/DarkField" android:hint="闪光 1=是 / 0=否（留空不修改）" android:inputType="number" /><EditText android:id="@+id/egg_input" style="@style/DarkField" android:hint="蛋状态 1=是 / 0=否（留空不修改）" android:inputType="number" /><EditText android:id="@+id/item_input" style="@style/DarkField" android:hint="携带道具编号，0=无" android:inputType="number" /><EditText android:id="@+id/status_input" style="@style/DarkField" android:hint="异常状态编号，0=无" android:inputType="number" /><EditText android:id="@+id/pokerus_input" style="@style/DarkField" android:hint="宝可病毒：株/天，例如 3/4" /><EditText android:id="@+id/moves_input" style="@style/DarkField" android:hint="4 个招式编号，逗号分隔" android:inputType="number" /><EditText android:id="@+id/ivs_input" style="@style/DarkField" android:hint="6 个个体值 0–31，逗号分隔" android:inputType="number" /><EditText android:id="@+id/evs_input" style="@style/DarkField" android:hint="6 个努力值，总和≤510，逗号分隔" android:inputType="number" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp"><Button android:id="@+id/save_nickname" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginRight="4dp" android:backgroundTint="#1B312D" android:text="保存副本" android:textColor="#8DE4D1" android:textSize="11sp" /><Button android:id="@+id/discard_edits" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginLeft="4dp" android:backgroundTint="#1B312D" android:text="丢弃编辑" android:textColor="#FF9E64" android:textSize="11sp" /></LinearLayout>
    </LinearLayout>
    <Button android:id="@+id/transfer_button" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="20dp" android:background="@drawable/primary_button" android:enabled="false" android:text="传送至心金存档" android:textColor="#142019" android:textStyle="bold" />
    <Button android:id="@+id/export_backup_button" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="9dp" android:backgroundTint="#1B312D" android:enabled="false" android:text="导出最近备份" android:textColor="#8DE4D1" android:textSize="11sp" android:visibility="gone" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="闪光 · 携带道具 · 异常状态 · 宝可病毒 · 蛋 · 形态 · 丝带均会保留或明确报告。通过合法性检查后才可导出。" android:textColor="#628078" android:textSize="10sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/history_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="传送记录" android:textColor="#E9F4EF" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="本地记录 · 不上传网络" android:textColor="#91AAA1" android:textSize="11sp" />
    <TextView android:id="@+id/history_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/card" android:padding="13dp" android:text="暂无传送记录" android:textColor="#91AAA1" android:textSize="11sp" />
    </LinearLayout>
  </LinearLayout>
</ScrollView>
