<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for Android 12+ (API 31+).

  Backup stays enabled so the user's own data (registered saves and the central
  warehouse under files/) survives a device change. The GitHub credential and binding
  preferences are excluded from BOTH cloud backup and device-to-device transfer: the
  token ciphertext is useless without the device-bound Keystore key, and the repository
  identity is not something that should leave the device.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="sharedpref" path="remote-save-secret.xml" />
    <exclude domain="sharedpref" path="remote-save-binding.xml" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="sharedpref" path="remote-save-secret.xml" />
    <exclude domain="sharedpref" path="remote-save-binding.xml" />
  </device-transfer>
</data-extraction-rules>
